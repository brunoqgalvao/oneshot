OPENAI_API_KEY=sk-...
PORT=8787
DATABASE_PATH=./data/murmur.db
# Free tier: seconds of audio per user per UTC day (default 30 min)
FREE_DAILY_SECONDS=1800
# Safety cap across all users per UTC day (default 10 h ≈ US$4/day of transcription)
GLOBAL_DAILY_SECONDS=36000
TRANSCRIBE_MODEL=gpt-4o-transcribe
CLEANUP_MODEL=gpt-5.4-mini
COMMAND_MODEL=gpt-5.4-mini
